{
  "opencollection": "1.0.0",
  "info": {
    "name": "agent-states-api-v2 AccountSet Uuid API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Uuid",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Set Agent State by UUID",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{instance}.response.lithium.com/api/v2/agentstate/uuid/:userUUID/state",
            "params": [
              {
                "name": "stateUUID",
                "value": "",
                "type": "query",
                "description": "The unique identifier for the state to which the Agent will be switched."
              },
              {
                "name": "userUUID",
                "value": "",
                "type": "path",
                "description": "The universally unique identifier (UUID) of the Agent being placed into a new state."
              }
            ]
          },
          "docs": "Set the State (`stateUUID`) of an active Agent identified by UUID (`userUUID`)"
        }
      ]
    }
  ],
  "bundled": true
}