              },
              {
                "name": "include_deleted_crm",
                "value": "",
                "type": "query",
                "description": "When `true`, the response includes authors whose CRM entry has been deleted. Otherwise, the response will not include authors whose CRM entry has been deleted."
              }
            ]
          },
