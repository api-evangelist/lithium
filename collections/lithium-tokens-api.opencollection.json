{
  "opencollection": "1.0.0",
  "info": {
    "name": "agent-states-api-v2 AccountSet Tokens API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Refresh JWT",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{instance}.response.lithium.com/api/v2/agentstate/tokens/appId/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The `appId` of the bot defined in the bot registration"
              }
            ]
          },
          "docs": "Refresh the JWT used to authenticate calls to the Bot v3 API"
        },
        {
          "info": {
            "name": "Invalidate JWT",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}.response.lithium.com/api/v2/agentstate/tokens/appId/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The `appId` of the bot as defined in the bot registration"
              }
            ]
          },
          "docs": "Invalidate the JWT used to authenticate calls to the Bot v3 API"
        }
      ]
    }
  ],
  "bundled": true
}